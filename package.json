{
  "name": "hollows",
  "version": "1.0.0",
  "scripts": {
    "createSymlinks": "node tools/create-symlinks.mjs",
    "db:unpack": "node tools/pack-level-db.mjs package unpack",
    "db:pack": "node tools/pack-level-db.mjs package pack",
    "dev": "rollup --c tools/rollup.config.mjs --watch",
    "build": "npm run db:pack && npm run build:code",
    "build:code": "rollup --c tools/rollup.config.mjs",
    "postinstall": "npm run createSymlinks"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@foundryvtt/foundryvtt-cli": "^3.0.0",
    "@html-eslint/eslint-plugin": "^0.26.0",
    "@html-eslint/parser": "^0.26.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-jsdoc": "^51.4.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.0",
    "rollup": "^4.59.0",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
